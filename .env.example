# 部署bridge-server脚本配置
DEPLOY_SSH_TARGET=root@your-server.com
DEPLOY_REMOTE_DIR=/path/to/deploy/xiaohongshu-auto-skills-bridge
DEPLOY_SSH_PORT=22
# DEPLOY_IDENTITY_FILE=/path/to/your/id_rsa


# 小红书自动化 Skill 配置文件
# 首次使用时会通过交互式 AskUserQuestion 引导填写
# 验证通过后自动保存为 .env

XHS_BRIDGE_URL="ws://localhost:9333/ws"
XHS_BRIDGE_TOKEN="your-bridge-token"
XHS_BRIDGE_SESSION_ID="your-extension-session-id"

# 自动风险门禁默认关闭；仅在规则校准后显式启用。
XHS_RISK_GATE_ENABLED=false
